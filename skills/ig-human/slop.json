    "structures": [
      {
        "id": "zh-not-a-but-b",
        "regex": "(?:不是|並非|并非)[^，。！？\\n]{1,24}[，,]\\s*而是|唔係[^，。！？\\n]{1,24}[，,]\\s*而係",
        "name": "不是A，而是B",
        "fix": "Say B. The A half is a setup nobody asked for."
      },
      {
        "id": "zh-not-only",
        "regex": "(?:不僅|不仅|不只|不止|唔止)(?:僅|仅)?(?:是|係)?[^。！？\\n]{1,30}[，,]\\s*(?:更|還|还|而且|仲)",
        "name": "不僅A，更是B",
        "fix": "Split it, or keep the half with a fact in it."
      },
      {
        "id": "zh-era-opener",
        "regex": "(?:在這個|在这个|喺呢個)[^，。！？\\n]{0,12}(?:的|嘅)時代|在这个[^，。！？\\n]{0,12}的时代|(?:隨著|随着|隨住)[^，。！？\\n]{0,12}(?:的|嘅)(?:發展|发展)",
        "name": "在這個…的時代 / 隨著…的發展",
        "fix": "Delete the opener and start on the claim, or put a date on it."
      },
      {
        "id": "zh-first-second-last",
        "regex": "首先[^。！？]{1,80}其次[^。！？]{1,80}(?:最後|最后)",
        "name": "首先…其次…最後",
        "fix": "Number the points or drop the connectives. Spoken Chinese does not list like a report."
      },
      {
        "id": "zh-rhetorical-qa",
        "regex": "(?:為什麼|为什么|點解)[？?]\\s*(?:因為|因为)",
        "name": "為什麼？因為…",
        "fix": "State the reason. The question is a stage direction."
      },
      {
        "id": "zh-empty-promise",
        "regex": "無限可能|无限可能|更多可能|全新的可能|拭目以待",
        "name": "無限可能 / 拭目以待",
        "fix": "Name the one thing that changes, or cut the sentence."
      },
      {
        "id": "zh-save-bait",
        "regex": "建議收藏|建议收藏|快筆記起來|快笔记起来|码住|記得\\s*save\\s*低",
        "name": "建議收藏 reflex",
        "fix": "Say why someone would come back to this. The reflex ask trains people to ignore it."
      },
      {
        "id": "zh-jinxing",
        "regex": "(?:進行|进行)了?(?:分析|調整|调整|改善|處理|处理|溝通|沟通|研究|說明|说明)",
        "name": "進行 + verb",
        "fix": "Drop 進行 and keep the verb: 分析, 調整, 處理."
      },
      {
        "id": "zh-four-char-triplet",
        "regex": "[\\u4e00-\\u9fff]{4}、[\\u4e00-\\u9fff]{4}、[\\u4e00-\\u9fff]{4}",
        "name": "Three four-character phrases in a row",
        "fix": "Keep the one that is concrete. Triplets of 四字詞 read as a brochure."
      },
      {
        "id": "zh-emoji-bullets",
        "regex": "(?m)(?:^[ \\t]*(?:✅|🔥|🚀|👉|✨|📌|💡|⭐)\\uFE0F?[ \\t]*\\S[^\\n]*\\n?){3,}",
        "name": "Emoji-bullet list",
        "fix": "Write it as sentences, or use plain numbers. Three emoji bullets in a row is the chatbot list."
      },
      {
        "id": "zh-markdown",
        "regex": "(?m)\\*\\*[^*\\n]+\\*\\*|^#{1,3}[ \\t]",
        "name": "Markdown in a caption",
        "fix": "Instagram renders neither bold nor headings. This was pasted from a chatbot."
      }
    ]
  }
